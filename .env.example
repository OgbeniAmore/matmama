# Copy this file to .env and fill in your credentials.
# NEVER commit .env to source control — it is in .gitignore.

# ── Frontend (public, exposed to browser) ─────────────────────────────────────
VITE_SUPABASE_URL="https://wwhkfahlmivbqbtyidfr.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# ── Edge Function Secrets ──────────────────────────────────────────────────────
# Set these in: Supabase Dashboard → Project Settings → Edge Functions → Secrets
# They are NOT available at build time; only the edge function runtime reads them.

# --- SMS via Termii (https://termii.com) ---
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="MatMama"          # Must be approved by Termii

# --- WhatsApp via Twilio (https://console.twilio.com) ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# Sandbox number for testing: +14155238886
# Production: your approved Twilio WhatsApp Business number
TWILIO_WHATSAPP_NUMBER="+14155238886"

# --- AI message generation (https://platform.openai.com) ---
OPENAI_API_KEY="sk-..."

# --- Cron security (optional but recommended) ---
# If set, the daily cron and retry-queue calls must include this value in the
# x-cron-secret header. Leave empty to rely on network-level security only.
# If you set this, store it in Supabase Vault and update the cron job SQL to
# read it via: SELECT decrypted_secret FROM vault.decrypted_secrets WHERE name = 'CRON_SECRET'
CRON_SECRET=""

# ── Twilio webhook setup ───────────────────────────────────────────────────────
# In your Twilio WhatsApp sender settings, set the Status Callback URL to:
#   https://wwhkfahlmivbqbtyidfr.supabase.co/functions/v1/whatsapp-status-webhook
# This receives delivery receipts and schedules automatic retries on failure.

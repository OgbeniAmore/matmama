# Copy this file to .env and fill in your credentials

# Database
DATABASE_URL=sqlite:////workspace/data.db

# Timezone used for scheduling (IANA tz database name)
DEFAULT_TIMEZONE=UTC

# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Outbound sender numbers
# SMS: E.164 format like +12025550123
TWILIO_SMS_FROM=+12025550123
# WhatsApp: Twilio requires the whatsapp: prefix
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Copy this file to .env and fill in your credentials.
# NEVER commit .env to source control — it is in .gitignore.

# ── Frontend (public, exposed to browser) ─────────────────────────────────────
VITE_SUPABASE_URL="https://wwhkfahlmivbqbtyidfr.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# ── Edge Function Secrets ──────────────────────────────────────────────────────
# Set these in: Supabase Dashboard → Project Settings → Edge Functions → Secrets
# They are NOT in .env at runtime — the edge function runtime reads them.

# --- SMS via Termii (https://termii.com) ---
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="MatMama"          # Must be approved by Termii

# --- WhatsApp via WATI (https://app.wati.io) ---
# Instance URL: found in WATI dashboard → API Docs (e.g. https://live-server.wati.io)
WATI_API_KEY="your-wati-api-access-token"
WATI_INSTANCE_URL="https://live-server.wati.io"

# --- AI message generation (https://platform.openai.com) ---
OPENAI_API_KEY="sk-..."

# --- Cron security (optional but recommended) ---
# If set, the cron endpoint requires this value in the x-cron-secret header.
# Leave empty to skip the check (safe since the endpoint is still origin-restricted).
CRON_SECRET=""

# ── WATI webhook setup ────────────────────────────────────────────────────────
# In WATI dashboard → Configuration → Webhook, set:
#   Webhook URL: https://wwhkfahlmivbqbtyidfr.supabase.co/functions/v1/whatsapp-status-webhook
# This receives delivery receipts (sent / delivered / read / failed) and
# schedules automatic retries on failure via the hourly pg_cron worker.
#
# ── WATI note on proactive reminders ─────────────────────────────────────────
# The reminder function uses WATI's sendSessionMessage API.
# This works within 24 hours of the client last messaging your WATI number.
# For proactive reminders outside that window, create approved WhatsApp templates
# in WATI and use the sendTemplateMessage endpoint instead.
